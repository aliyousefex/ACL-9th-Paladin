\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Rows, podium rate, and qualifying missingness by season, coloured by split.}}{11}{figure.caption.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Split-strategy check with logistic regression. Leakage columns are shares of held-out rows.}}{11}{table.caption.18}\protected@file@percent }
