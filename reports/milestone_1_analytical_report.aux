\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces One-feature evidence on the training seasons. Missing cells are left out of the bins and the AUC. Valid. is the same AUC on 2020-2021.}}{13}{table.caption.22}\protected@file@percent }
