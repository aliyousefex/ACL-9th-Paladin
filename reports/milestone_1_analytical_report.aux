\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Primary-key audit of the raw tables. Null keys and duplicate keys are both zero in every audited table.}}{2}{table.caption.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Foreign-key audit. An orphan is a child value with no matching parent key. None were found.}}{3}{table.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Initial EDA of all fourteen raw tables: row counts and missing-cell shares before cleaning.}}{4}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Programmatic EDA at each cleaning stage. The left panel compares total rows with unique driver-race pairs; the right panel checks whether each step materially changes key rates.}}{5}{figure.caption.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cleaning diagnostics at each stage, computed from the raw results and the final modelling table.}}{5}{table.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Qualifying coverage is not stable across history}{5}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Share of driver-race rows with a recorded qualifying position, by season. Coverage is essentially zero until the mid-1990s, unstable until 2003, and then close to complete.}}{5}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Three questions about the races, before any model}{6}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Front-row starts convert to podiums much more often than other starts}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Ten circuits with the highest front-row podium rate in each era. The rate is podiums divided by front-row starts. Circuits with fewer than ten such starts are excluded.}}{6}{figure.caption.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Highest front-row podium rates in each era, among circuits with at least ten front-row starts. The rate is a proportion of starts, not a mean of lap times.}}{7}{table.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Once the grid band is fixed, home drivers do not podium more often}{7}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Podium rate by starting-grid band for home races (home\_race = True) and other races (home\_race = False). The two lines fall together as the start position gets worse.}}{7}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Podium rate at each exact starting-grid position for home and away starts. Recorded non-starters are excluded.}}{8}{figure.caption.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Podium rate by grid band and home status. The last column is the home rate minus the away rate, in percentage points.}}{8}{table.caption.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Mechanical retirement rates are lower in 2022-2024, and small teams sit at the top of each list}{8}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Mechanical-retirement sensitivity. The official instructor list is compared with a conservative list of internal-system labels.}}{9}{table.caption.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Ten constructors with the highest mechanical-retirement rate in each era, among those with at least 20 starts. The rate uses all starts as the denominator.}}{9}{figure.caption.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Highest and lowest mechanical-retirement rates in each era, plus a few large teams for scale. Rate = failures / starts, after removing non-starts.}}{10}{table.caption.14}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}What the model is allowed to see}{10}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Feature groups. Post-race position, points scored today, laps, status, pit stops, and fastest lap are excluded.}}{10}{table.caption.15}\protected@file@percent }
