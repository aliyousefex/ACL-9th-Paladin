"Driver":"Rubens Barrichello","Starts":19,"Avg_Finish":8.947368421052632,"Wins":0},{"Driver":"Robert Kubica","Starts":5,"Avg_Finish":9.0,"Wins":0},{"Driver":"Maurice Trintignant","Starts":11,"Avg_Finish":9.090909090909092,"Wins":2},{"Driver":"Felipe Massa","Starts":15,"Avg_Finish":9.333333333333334,"Wins":0},{"Driver":"Elio de Angelis","Starts":7,"Avg_Finish":9.428571428571429,"Wins":0},{"Driver":"Valtteri Bottas","Starts":7,"Avg_Finish":9.428571428571429,"Wins":0},{"Driver":"Nick Heidfeld","Starts":11,"Avg_Finish":9.454545454545455,"Wins":0},{"Driver":"Jean Alesi","Starts":12,"Avg_Finish":9.5,"Wins":0},{"Driver":"Niki Lauda","Starts":11,"Avg_Finish":9.545454545454545,"Wins":2},{"Driver":"Giancarlo Fisichella","Starts":14,"Avg_Finish":9.571428571428571,"Wins":0},{"Driver":"John Watson","Starts":8,"Avg_Finish":9.625,"Wins":0},{"Driver":"Carlos Reutemann","Starts":9,"Avg_Finish":9.666666666666666,"Wins":1},{"Driver":"Jack Brabham","Starts":14,"Avg_Finish":9.714285714285714,"Wins":1},{"Driver":"Kimi R\u00e4ikk\u00f6nen","Starts":17,"Avg_Finish":9.764705882352942,"Wins":1},{"Driver":"John Surtees","Starts":12,"Avg_Finish":9.833333333333334,"Wins":0},{"Driver":"Michele Alboreto","Starts":13,"Avg_Finish":9.923076923076923,"Wins":0},{"Driver":"Jacky Ickx","Starts":9,"Avg_Finish":10.11111111111111,"Wins":0},{"Driver":"Ralf Schumacher","Starts":11,"Avg_Finish":10.272727272727273,"Wins":0},{"Driver":"Gerhard Berger","Starts":12,"Avg_Finish":10.333333333333334,"Wins":0},{"Driver":"Max Verstappen","Starts":5,"Avg_Finish":10.8,"Wins":0},{"Driver":"Olivier Panis","Starts":10,"Avg_Finish":10.9,"Wins":1},{"Driver":"Jenson Button","Starts":17,"Avg_Finish":11.117647058823529,"Wins":1},{"Driver":"Chris Amon","Starts":7,"Avg_Finish":11.142857142857142,"Wins":0},{"Driver":"Dan Gurney","Starts":7,"Avg_Finish":11.142857142857142,"Wins":0},{"Driver":"Harry Schell","Starts":6,"Avg_Finish":11.142857142857142,"Wins":0},{"Driver":"Heinz-Harald Frentzen","Starts":8,"Avg_Finish":11.25,"Wins":0},{"Driver":"Jacques Villeneuve","Starts":10,"Avg_Finish":11.3,"Wins":0},{"Driver":"David Coulthard","Starts":14,"Avg_Finish":11.428571428571429,"Wins":2},{"Driver":"Riccardo Patrese","Starts":17,"Avg_Finish":11.470588235294118,"Wins":1},{"Driver":"Nigel Mansell","Starts":12,"Avg_Finish":11.5,"Wins":0},{"Driver":"Johnny Herbert","Starts":10,"Avg_Finish":11.7,"Wins":0},{"Driver":"Jean-Pierre Beltoise","Starts":7,"Avg_Finish":11.714285714285714,"Wins":1},{"Driver":"Jarno Trulli","Starts":15,"Avg_Finish":11.733333333333333,"Wins":1},{"Driver":"Nico H\u00fclkenberg","Starts":9,"Avg_Finish":11.777777777777779,"Wins":0},{"Driver":"Thierry Boutsen","Starts":9,"Avg_Finish":11.777777777777779,"Wins":0},{"Driver":"Patrick Tambay","Starts":6,"Avg_Finish":11.833333333333334,"Wins":0},{"Driver":"Jean-Pierre Jarier","Starts":8,"Avg_Finish":11.875,"Wins":0},{"Driver":"Jyrki J\u00e4rvilehto","Starts":5,"Avg_Finish":12.2,"Wins":0},{"Driver":"Adrian Sutil","Starts":7,"Avg_Finish":12.428571428571429,"Wins":0},{"Driver":"Damon Hill","Starts":7,"Avg_Finish":12.571428571428571,"Wins":0},{"Driver":"Mario Andretti","Starts":6,"Avg_Finish":12.666666666666666,"Wins":0},{"Driver":"Alan Jones","Starts":8,"Avg_Finish":12.75,"Wins":0},{"Driver":"Mika H\u00e4kkinen","Starts":10,"Avg_Finish":12.8,"Wins":1},{"Driver":"Daniil Kvyat","Starts":5,"Avg_Finish":12.8,"Wins":0},{"Driver":"Mike Hailwood","Starts":5,"Avg_Finish":12.8,"Wins":0},{"Driver":"Nelson Piquet","Starts":13,"Avg_Finish":12.846153846153847,"Wins":0},{"Driver":"Ren\u00e9 Arnoux","Starts":10,"Avg_Finish":13.0,"Wins":0},{"Driver":"Kevin Magnussen","Starts":5,"Avg_Finish":13.2,"Wins":0},{"Driver":"Sergio P\u00e9rez","Starts":9,"Avg_Finish":13.222222222222221,"Wins":0},{"Driver":"Derek Warwick","Starts":8,"Avg_Finish":13.25,"Wins":0},{"Driver":"Clay Regazzoni","Starts":7,"Avg_Finish":13.285714285714286,"Wins":0},{"Driver":"Heikki Kovalainen","Starts":6,"Avg_Finish":13.333333333333334,"Wins":0},{"Driver":"Pedro Diniz","Starts":6,"Avg_Finish":13.333333333333334,"Wins":0},{"Driver":"Romain Grosjean","Starts":8,"Avg_Finish":13.375,"Wins":0},{"Driver":"Eddie Cheever","Starts":7,"Avg_Finish":13.571428571428571,"Wins":0},{"Driver":"Marcus Ericsson","Starts":5,"Avg_Finish":13.6,"Wins":0},{"Driver":"Ivan Capelli","Starts":6,"Avg_Finish":13.666666666666666,"Wins":0},{"Driver":"Andrea de Cesaris","Starts":13,"Avg_Finish":14.0,"Wins":0},{"Driver":"Carlos Pace","Starts":5,"Avg_Finish":14.4,"Wins":0},{"Driver":"Hans-Joachim Stuck","Starts":5,"Avg_Finish":14.4,"Wins":0},{"Driver":"Philippe Alliot","Starts":5,"Avg_Finish":14.4,"Wins":0},{"Driver":"Vitantonio Liuzzi","Starts":5,"Avg_Finish":14.4,"Wins":0},{"Driver":"James Hunt","Starts":7,"Avg_Finish":14.428571428571429,"Wins":0},{"Driver":"Jos Verstappen","Starts":6,"Avg_Finish":14.833333333333334,"Wins":0},{"Driver":"Timo Glock","Starts":5,"Avg_Finish":16.0,"Wins":0},{"Driver":"Ukyo Katayama","Starts":5,"Avg_Finish":16.8,"Wins":0},{"Driver":"Pedro de la Rosa","Starts":6,"Avg_Finish":18.833333333333332,"Wins":0},{"Driver":"Stefano Modena","Starts":5,"Avg_Finish":19.2,"Wins":0},{"Driver":"Pierluigi Martini","Starts":6,"Avg_Finish":19.333333333333332,"Wins":0}],"sharedDrives":[{"driver":"Cesare Perdisa","year":1955},{"driver":"Jean Behra","year":1955},{"driver":"Eugenio Castellotti","year":1956},{"driver":"Juan Fangio","year":1956},{"driver":"Harry Schell","year":1957},{"driver":"Mike Hawthorn","year":1957}]},{"number":5,"title":"Who changed constructor between 2020 and 2021","question":"A driver's primary constructor in a season is the one with the most race entries (a tie goes to the lower constructorId). Which drivers who raced in both seasons had a different one in 2021?","note":"Constructors are compared by id, so a renamed team (Renault to Alpine) counts as a change.","cypher":"MATCH (d:Driver)<-[:BY_DRIVER]-(res:Result)-[:FOR_RACE]->(:Race)-[:IN_SEASON]->(s:Season),\n      (res)-[:FOR_CONSTRUCTOR]->(c:Constructor)\nWHERE s.year IN [2020, 2021]\nWITH d, s.year AS year, c, count(res) AS entries\nORDER BY entries DESC, c.constructorId ASC\nWITH d, year, collect(c.constructorId)[0] AS primary\nWITH d,\n     head([x IN collect({year: year, primary: primary}) WHERE x.year = 2020]).primary AS c2020,\n     head([x IN collect({year: year, primary: primary}) WHERE x.year = 2021]).primary AS c2021\nWHERE c2020 IS NOT NULL AND c2021 IS NOT NULL AND c2020 <> c2021\nWITH d.forename + ' ' + d.surname AS name\nORDER BY name\nRETURN count(name) AS Drivers_Changed, collect(name) AS Drivers","columns":["Drivers_Changed","Drivers"],"rows":[{"Drivers_Changed":6,"Drivers":["Carlos Sainz","Daniel Ricciardo","Esteban Ocon","Lance Stroll","Sebastian Vettel","Sergio P\u00e9rez"]}],"moves":[{"driver":"Carlos Sainz","from":"McLaren","to":"Ferrari"},{"driver":"Daniel Ricciardo","from":"Renault","to":"McLaren"},{"driver":"Esteban Ocon","from":"Renault","to":"Alpine F1 Team"},{"driver":"Lance Stroll","from":"Racing Point","to":"Aston Martin"},{"driver":"Sebastian Vettel","from":"Ferrari","to":"Aston Martin"},{"driver":"Sergio P\u00e9rez","from":"Racing Point","to":"Red Bull"}]}]}
