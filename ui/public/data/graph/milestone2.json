{"contract":"paladin.milestone2.v1","source":{"files":["milestone_2/drivers.csv","milestone_2/constructors.csv","milestone_2/circuits.csv","milestone_2/seasons.csv","milestone_2/status.csv","milestone_2/races.csv","milestone_2/results.csv","milestone_2/qualifying.csv","milestone_2/pit_stops.csv","milestone_2/queries.txt"],"sha256":"28c666552565f727fa1b3b013d9236b872305d69065ce5243488299d5a18e96c"},"counts":{"nodes":51113,"relationships":163510},"schema":[{"label":"Driver","kind":"entity","key":"driverId","count":861,"properties":[{"name":"driverId","type":"integer"},{"name":"driverRef","type":"text"},{"name":"number","type":"integer"},{"name":"code","type":"text"},{"name":"forename","type":"text"},{"name":"surname","type":"text"},{"name":"dob","type":"date"},{"name":"nationality","type":"text"}]},{"label":"Constructor","kind":"entity","key":"constructorId","count":212,"properties":[{"name":"constructorId","type":"integer"},{"name":"constructorRef","type":"text"},{"name":"constructor_name","type":"text"},{"name":"constructor_nationality","type":"text"}]},{"label":"Circuit","kind":"entity","key":"circuitId","count":77,"properties":[{"name":"circuitId","type":"integer"},{"name":"circuitRef","type":"text"},{"name":"circuit_name","type":"text"},{"name":"circuit_loc","type":"text"},{"name":"circuit_country","type":"text"},{"name":"lat","type":"float"},{"name":"lng","type":"float"},{"name":"alt","type":"integer"}]},{"label":"Season","kind":"entity","key":"year","count":75,"properties":[{"name":"year","type":"integer"}]},{"label":"Status","kind":"entity","key":"statusId","count":139,"properties":[{"name":"statusId","type":"integer"},{"name":"status","type":"text"}]},{"label":"Race","kind":"entity","key":"raceId","count":1125,"properties":[{"name":"raceId","type":"integer"},{"name":"year","type":"integer"},{"name":"round","type":"integer"},{"name":"name","type":"text"},{"name":"date","type":"date"},{"name":"time","type":"text"}]},{"label":"Result","kind":"fact","key":"resultId","count":26759,"properties":[{"name":"resultId","type":"integer"},{"name":"number","type":"integer"},{"name":"grid","type":"integer"},{"name":"position","type":"integer"},{"name":"positionText","type":"text"},{"name":"positionOrder","type":"integer"},{"name":"points","type":"float"},{"name":"laps","type":"integer"},{"name":"time","type":"text"},{"name":"milliseconds","type":"integer"},{"name":"fastestLap","type":"integer"},{"name":"rank","type":"integer"},{"name":"fastestLapTime","type":"text"},{"name":"fastestLapSpeed","type":"float"}]},{"label":"Qualifying","kind":"fact","key":"qualifyId","count":10494,"properties":[{"name":"qualifyId","type":"integer"},{"name":"number","type":"integer"},{"name":"position","type":"integer"},{"name":"q1","type":"text"},{"name":"q2","type":"text"},{"name":"q3","type":"text"}]},{"label":"PitStop","kind":"fact","key":"eventId","count":11371,"properties":[{"name":"eventId","type":"text"},{"name":"stop","type":"integer"},{"name":"lap","type":"integer"},{"name":"time","type":"text"},{"name":"duration","type":"text"},{"name":"milliseconds","type":"integer"}]}],"relationships":[{"type":"AT_CIRCUIT","from":"Race","to":"Circuit","count":1125},{"type":"IN_SEASON","from":"Race","to":"Season","count":1125},{"type":"FOR_RACE","from":"Result","to":"Race","count":26759},{"type":"BY_DRIVER","from":"Result","to":"Driver","count":26759},{"type":"FOR_CONSTRUCTOR","from":"Result","to":"Constructor","count":26759},{"type":"HAS_STATUS","from":"Result","to":"Status","count":26759},{"type":"FOR_RACE","from":"Qualifying","to":"Race","count":10494},{"type":"BY_DRIVER","from":"Qualifying","to":"Driver","count":10494},{"type":"FOR_CONSTRUCTOR","from":"Qualifying","to":"Constructor","count":10494},{"type":"FOR_RACE","from":"PitStop","to":"Race","count":11371},{"type":"BY_DRIVER","from":"PitStop","to":"Driver","count":11371}],"questions":[{"number":1,"title":"The 2021 standings","question":"Each driver's total Grand Prix points and number of wins in 2021, the most points first.","note":"Race-result points only: the graph does not load sprint results, so a total can sit below the official one.","cypher":"MATCH (d:Driver)<-[:BY_DRIVER]-(res:Result)-[:FOR_RACE]->(r:Race)-[:IN_SEASON]->(:Season {year: 2021})\nWITH d, sum(res.points) AS Points, count(CASE WHEN res.position = 1 THEN 1 END) AS Wins\nRETURN d.forename + ' ' + d.surname AS Driver, Points, Wins\nORDER BY Points DESC, Wins DESC, Driver ASC","columns":["Driver","Points","Wins"],"rows":[{"Driver":"Max Verstappen","Points":388.5,"Wins":10},{"Driver":"Lewis Hamilton","Points":385.5,"Wins":8},{"Driver":"Valtteri Bottas","Points":219.0,"Wins":1},{"Driver":"Sergio P\u00e9rez","Points":190.0,"Wins":1},{"Driver":"Carlos Sainz","Points":163.5,"Wins":0},{"Driver":"Lando Norris","Points":160.0,"Wins":0},{"Driver":"Charles Leclerc","Points":159.0,"Wins":0},{"Driver":"Daniel Ricciardo","Points":114.0,"Wins":1},{"Driver":"Pierre Gasly","Points":110.0,"Wins":0},{"Driver":"Fernando Alonso","Points":81.0,"Wins":0},{"Driver":"Esteban Ocon","Points":74.0,"Wins":1},{"Driver":"Sebastian Vettel","Points":43.0,"Wins":0},{"Driver":"Lance Stroll","Points":34.0,"Wins":0},{"Driver":"Yuki Tsunoda","Points":32.0,"Wins":0},{"Driver":"George Russell","Points":16.0,"Wins":0},{"Driver":"Kimi R\u00e4ikk\u00f6nen","Points":10.0,"Wins":0},{"Driver":"Nicholas Latifi","Points":7.0,"Wins":0},{"Driver":"Antonio Giovinazzi","Points":3.0,"Wins":0},{"Driver":"Mick Schumacher","Points":0.0,"Wins":0},{"Driver":"Nikita Mazepin","Points":0.0,"Wins":0},{"Driver":"Robert Kubica","Points":0.0,"Wins":0}]},{"number":2,"title":"Which constructors finished races most often","question":"For every constructor with at least 100 race entries from 2014 to 2021: how many of those entries were classified finishes (status Finished, or a lap or more down), and what share is that?","note":"Reliability is classified entries divided by entries, a value from 0 to 1.","cypher":"MATCH (c:Constructor)<-[:FOR_CONSTRUCTOR]-(res:Result)-[:FOR_RACE]->(r:Race)-[:IN_SEASON]->(s:Season)\nWHERE s.year >= 2014 AND s.year <= 2021\nMATCH (res)-[:HAS_STATUS]->(st:Status)\nWITH c, count(res) AS Entries, count(CASE WHEN st.status = 'Finished' OR st.status STARTS WITH '+' THEN 1 END) AS Classified\nWHERE Entries >= 100\nRETURN c.constructor_name AS Constructor, Entries, Classified, toFloat(Classified) / Entries AS Reliability\nORDER BY Reliability DESC, Constructor ASC","columns":["Constructor","Entries","Classified","Reliability"],"rows":[{"Constructor":"Mercedes","Entries":320,"Classified":298,"Reliability":0.93125},{"Constructor":"Alfa Romeo","Entries":120,"Classified":109,"Reliability":0.9083333333333333},{"Constructor":"Ferrari","Entries":320,"Classified":277,"Reliability":0.865625},{"Constructor":"Force India","Entries":200,"Classified":169,"Reliability":0.845},{"Constructor":"Williams","Entries":320,"Classified":266,"Reliability":0.83125},{"Constructor":"Red Bull","Entries":320,"Classified":263,"Reliability":0.821875},{"Constructor":"McLaren","Entries":320,"Classified":248,"Reliability":0.775},{"Constructor":"Haas F1 Team","Entries":244,"Classified":188,"Reliability":0.7704918032786885},{"Constructor":"Renault","Entries":200,"Classified":151,"Reliability":0.755},{"Constructor":"Sauber","Entries":200,"Classified":149,"Reliability":0.745},{"Constructor":"Toro Rosso","Entries":242,"Classified":180,"Reliability":0.743801652892562}]},{"number":3,"title":"Hamilton and Bottas in the same car","question":"In the races the two drove for the same constructor: how many they shared, and how many times each finished ahead.","note":"Ahead means a lower positionOrder in the same race, for the same constructor.","cypher":"MATCH (h:Result)-[:BY_DRIVER]->(:Driver {driverId: 1}),\n      (b:Result)-[:BY_DRIVER]->(:Driver {driverId: 822}),\n      (h)-[:FOR_RACE]->(r:Race)<-[:FOR_RACE]-(b),\n      (h)-[:FOR_CONSTRUCTOR]->(c:Constructor)<-[:FOR_CONSTRUCTOR]-(b)\nRETURN c.constructor_name AS Constructor,\n       count(*) AS Shared_Races,\n       count(CASE WHEN h.positionOrder < b.positionOrder THEN 1 END) AS Hamilton_Ahead,\n       count(CASE WHEN b.positionOrder < h.positionOrder THEN 1 END) AS Bottas_Ahead","columns":["Constructor","Shared_Races","Hamilton_Ahead","Bottas_Ahead"],"rows":[{"Constructor":"Mercedes","Shared_Races":100,"Hamilton_Ahead":75,"Bottas_Ahead":25}]},{"number":4,"title":"Monaco before 2020","question":"At the Circuit de Monaco, in races before 2020, for drivers with at least five starts: their average finishing position and their wins, the best average first.","note":"A start is a race, however many Results a shared drive gave. The average and the wins are taken over all of a driver's remaining Results.","cypher":"MATCH (:Circuit {circuitId: 6})<-[:AT_CIRCUIT]-(r:Race)<-[:FOR_RACE]-(res:Result)-[:BY_DRIVER]->(d:Driver),\n      (res)-[:HAS_STATUS]->(st:Status)\nWHERE r.date < date('2020-01-01')\n  AND NOT st.status IN ['Did not qualify', 'Did not prequalify', 'Withdrew']\nWITH d, count(DISTINCT r) AS Starts, toFloat(sum(res.positionOrder)) / count(res) AS Avg_Finish,\n     count(CASE WHEN res.position = 1 THEN 1 END) AS Wins\nWHERE Starts >= 5\nRETURN d.forename + ' ' + d.surname AS Driver, Starts, Avg_Finish, Wins\nORDER BY Avg_Finish ASC, Wins DESC, Driver ASC","columns":["Driver","Starts","Avg_Finish","Wins"],"rows":[{"Driver":"Ayrton Senna","Starts":10,"Avg_Finish":3.8,"Wins":6},{"Driver":"Lewis Hamilton","Starts":13,"Avg_Finish":4.0,"Wins":3},{"Driver":"Phil Hill","Starts":5,"Avg_Finish":4.2,"Wins":0},{"Driver":"Jody Scheckter","Starts":7,"Avg_Finish":4.285714285714286,"Wins":2},{"Driver":"Lorenzo Bandini","Starts":5,"Avg_Finish":4.8,"Wins":0},{"Driver":"Jochen Mass","Starts":5,"Avg_Finish":5.0,"Wins":0},{"Driver":"Keke Rosberg","Starts":5,"Avg_Finish":5.2,"Wins":1},{"Driver":"Jackie Stewart","Starts":8,"Avg_Finish":5.25,"Wins":3},{"Driver":"Sebastian Vettel","Starts":12,"Avg_Finish":5.25,"Wins":2},{"Driver":"Alain Prost","Starts":13,"Avg_Finish":6.2307692307