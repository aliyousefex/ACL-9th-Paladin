{
  "name": "paladin-cutoff",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --pretty false && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report ../artifacts/visual-qa/playwright-report",
    "evaluate:decision": "node scripts/evaluate-decision.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
